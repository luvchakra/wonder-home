# WonderHome is pinned to a single Supabase project: stehegovxlssxdepiruk
# Anything pointing elsewhere is rejected by `npm run check:env` and at runtime.
# Copy this file to .env.local and fill in the keys from:
#   Supabase dashboard -> WonderHome project -> Project Settings -> API Keys

# --- Public (shipped to the browser, protected by Row Level Security) ---
NEXT_PUBLIC_SUPABASE_URL=https://stehegovxlssxdepiruk.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Server only. Never prefix these with NEXT_PUBLIC_ and never commit them. ---
# Bypasses Row Level Security. Used by src/lib/supabase/admin.ts.
SUPABASE_SECRET_KEY=sb_secret_...

# Direct Postgres connection, used only by migration/CLI tooling.
# SUPABASE_DB_URL=postgresql://postgres:<password>@db.stehegovxlssxdepiruk.supabase.co:5432/postgres
