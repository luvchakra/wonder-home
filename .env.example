# WonderHome environment contract (packages/core/src/config/env.ts).
# Copy to apps/web/.env.local and fill in — Next.js loads env from the app
# directory, not the repository root. Never commit real credentials.

# Supabase project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable (anon) key. Browser-safe: RLS applies to everything it can reach.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service-role key. SERVER ONLY — bypasses RLS. Never expose to the browser,
# never log it, never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Feature flags (packages/core/src/config/flags.ts). Optional; each falls back
# to its documented default. Flags gate rollout, never authorization.
# WONDERHOME_FLAG_VOICE_CONVERSATION=false
# WONDERHOME_FLAG_PROACTIVE_AGENTS=false
# WONDERHOME_FLAG_WHATSAPP_CHANNEL=false

# Log level: debug | info | warn | error (default info).
# LOG_LEVEL=info

# The assistant's model (packages/core/src/ai/model-key.ts). Without a key the
# assistant still works from WonderHome's own rules, and Settings says so.
# WONDERHOME_AI_KEY=            # the platform's provider key (server only)
# WONDERHOME_AI_PROVIDER=anthropic   # anthropic/claude | google/gemini | openai; unset or unknown: read from the key prefix, else anthropic
# WONDERHOME_AI_MODEL=          # optional model override for the chosen provider
# WONDERHOME_AI_UNDERSTANDING_MODEL=  # Anthropic only: the fast model that reads a sentence (default claude-haiku-5-5)
# WONDERHOME_AI_ANSWER_MODEL=         # Anthropic only: the model that composes and translates answers (default claude-sonnet-5-5)
# WONDERHOME_AI_INTAKE_MODEL=         # Anthropic only: the model HomeSend reads messages, photos and PDFs with (default claude-sonnet-5-5)

# Alexa skill (apps/web/app/api/v1/voice/alexa, integrations/alexa/README.md).
# Inert until set: the endpoint answers 401 and account linking says it isn't
# set up. Created in the Alexa developer console by a person — never invented.
# ALEXA_SKILL_ID=               # amzn1.ask.skill.<uuid>, pinned on every request
# ALEXA_OAUTH_CLIENT_ID=        # the account-linking client id entered in the console
# ALEXA_OAUTH_CLIENT_SECRET=    # at least 16 characters (server only)
# ALEXA_OAUTH_REDIRECT_URIS=    # the console's "Alexa Redirect URLs", comma separated

# WonderHome's own outgoing email (packages/core/src/email/mailer.ts): today the
# family-member invite (story 01-010). Inert until host, user and password are
# all set — the Invite sheet then offers only the Admin's own mail app.
# Production uses the GoDaddy mailbox connect@wonderapps.biz; the password lives
# only in Vercel's environment, never here.
# WONDERHOME_SMTP_HOST=         # e.g. smtpout.secureserver.net
# WONDERHOME_SMTP_PORT=465      # 465 implicit TLS (default) or 587 STARTTLS
# WONDERHOME_SMTP_USER=         # the mailbox, e.g. connect@wonderapps.biz
# WONDERHOME_SMTP_PASSWORD=     # server only
# WONDERHOME_SMTP_FROM=         # optional; defaults to "WonderHome <user>"

# Sign-in by phone (story 01-011): a one-time code by SMS. Turn on only after
# Phone is enabled in Supabase Auth with an SMS provider (Twilio, MessageBird,
# Vonage or Textlocal) and its credentials; until then no screen offers it.
# NEXT_PUBLIC_PHONE_AUTH_ENABLED=true

# Films and shows on Home's date card (TMDB). A v4 read-access token or a v3 key; unset = the card shows none.
TMDB_API_KEY=

# Careers (WonderJobs). A platform admin pastes the career-site key at /platform-admin/careers (kept in Vault);
# this is only the fallback when none is saved there. The key starts with wjcs_.
WONDERJOBS_CAREERS_KEY=
# Optional: another WonderJobs on an https *.wonderapps.biz host (a staging one). Anything else is refused.
WONDERJOBS_CAREERS_URL=
