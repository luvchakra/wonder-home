# WonderHome environment contract (packages/core/src/config/env.ts).
# Copy to apps/web/.env.local and fill in — Next.js loads env from the app
# directory, not the repository root. Never commit real credentials.
#
# ONE PLACE FOR CONFIGURATION (owner, 2026-11-22): a deployment (Vercel, the
# GitHub background-jobs runner) holds only the variables below. Everything
# else — AI keys and models, WhatsApp (token, app secret, verify token),
# payments (Razorpay/Stripe keys and webhook secrets), email (SMTP, Resend,
# unsubscribe link secret), Alexa, maps, weather, films, careers, school
# portals, sign-in switches, contact email and feature flags — is set in
# Platform admin (/platform-admin: AI & providers, Integrations,
# Configuration) and read from `platform_config` / Vault
# (packages/core/src/platform/settings/registry.ts). For local `next dev` and
# unit tests a registry name may also be set here; a saved value wins.
# Inventory and reasons: docs/progress/2026-11-22-platform-config-one-place.md.

# --- Bootstrap: needed to reach the settings store itself -------------------
# Supabase project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable (anon) key. Browser-safe: RLS applies to everything it can reach.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service-role key. SERVER ONLY — bypasses RLS. Never expose to the browser,
# never log it, never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Platform-required: read by the platform or before the store is --------
# Vercel Cron signs its calls with this (Vercel reads the variable itself).
# CRON_SECRET=
# Optional. Platform admin → Performance's advisor; never kept in the database it controls.
# SUPABASE_ACCESS_TOKEN=
# Optional. Who may open Platform admin, by VERIFIED email (a Google sign-in, or
# an email-and-password account whose email is confirmed; phone-only never
# matches). Comma-separated `email` or `email:role`, role = support | operator |
# owner; no role means operator. WARNING: `owner` is full control, secrets and
# staff included. Applied at each person's next sign-in (and first request after
# a deploy); removing an email suspends only rows this variable made, never one
# added by hand. Deployment-only: never saved in Platform admin.
# WONDERHOME_PLATFORM_ADMINS=you@example.com:owner, helper@example.com:support
# Optional. report-only (default) | enforce — read by the request proxy on every page.
# CSP_MODE=report-only
# Optional. debug | info | warn | error (default info) — the logger starts before the store.
# LOG_LEVEL=info
# Optional. The site's own address; on Vercel its production address is used.
# NEXT_PUBLIC_SITE_URL=
