{
  "name": "wonderhome",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "start": "npm run start -w apps/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && npm run test:scripts",
    "test:e2e": "playwright test",
    "lint:boundaries": "node scripts/lint-import-boundaries.mjs",
    "lint:migrations": "node scripts/lint-migration-schema.mjs",
    "lint:embeds": "node scripts/lint-postgrest-embeds.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:db": "node scripts/setup-test-db.mjs --template && node --test --test-concurrency=4 scripts/test-*-rls.mjs",
    "lint:secrets": "node scripts/lint-secrets.mjs",
    "verify:live": "node scripts/verify-live-project.mjs",
    "qa:test-user": "node scripts/qa-test-user.mjs",
    "tracker": "node scripts/build-progress.mjs",
    "brand": "node --experimental-strip-types --no-warnings scripts/build-brand-assets.ts",
    "security": "node scripts/security-suite.mjs",
    "eval": "node scripts/eval.mjs",
    "verify": "npm run typecheck && npm run lint && npm run lint:migrations && npm run lint:embeds && npm run lint:boundaries && npm run lint:secrets && npm run tracker -- --check && npm run brand -- --check && npm run security && npm run eval && npm run test && npm run test:db && npm run build && E2E_SKIP_BUILD=1 npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "typescript": "^5.9.3"
  }
}
